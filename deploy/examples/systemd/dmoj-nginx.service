[Unit]
Description=DMOJ nginx front end
After=network.target dmoj-web.service dmoj-events.service

[Service]
Type=simple
User=dmoj-proxy
Group=dmoj-proxy
WorkingDirectory=/
ExecStart=/usr/sbin/nginx -c /etc/dmoj-services/nginx.conf -g "daemon off;"
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
RuntimeDirectory=dmoj-nginx
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
