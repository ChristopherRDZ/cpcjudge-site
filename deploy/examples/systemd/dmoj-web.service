[Unit]
Description=DMOJ web application
After=network.target mariadb.service redis-server.service dmoj-bridge.service dmoj-events.service
RequiresMountsFor=/srv/dmoj/site /srv/dmoj/venv

[Service]
Type=simple
User=dmoj-uwsgi
Group=dmoj-uwsgi
WorkingDirectory=/srv/dmoj/site
ExecStart=/srv/dmoj/venv/bin/uwsgi --ini uwsgi.ini --die-on-term
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=120
UMask=0022
Environment=HOME=/nonexistent
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/srv/dmoj/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=DMOJ_SERVICE_LOG_DIR=/var/log/dmoj-web
Environment=DMOJ_SERVICE_MEDIA_ROOT=/srv/dmoj/media/
LogsDirectory=dmoj-web
LogsDirectoryMode=0700
RuntimeDirectory=dmoj-web
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
BindReadOnlyPaths=/srv/dmoj/site /srv/dmoj/venv
InaccessiblePaths=-/srv/dmoj/site/.git
ReadWritePaths=/srv/dmoj/problems /run/dmoj-web /srv/dmoj/media

[Install]
WantedBy=multi-user.target
