[Unit]
Description=DMOJ event daemon
After=network.target

[Service]
Type=simple
User=dmoj-events
Group=dmoj-events
WorkingDirectory=/srv/dmoj/site
ExecStart=/usr/bin/node /srv/dmoj/site/websocket/daemon.js
Restart=on-failure
RestartSec=5
UMask=0022
Environment=HOME=/nonexistent
Environment=NODE_PATH=/srv/dmoj/node_modules
BindReadOnlyPaths=/srv/dmoj/site /srv/dmoj/node_modules
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
